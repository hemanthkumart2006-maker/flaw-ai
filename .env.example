# Flaw AI Ultra Environment Configuration

# ==============================================================================
# AI Provider API Keys (Server-Side Only - Optional)
# fLAW AI automatically detects which providers are configured.
# If no keys are provided, the server still boots safely without crashing.
# ==============================================================================
GEMINI_API_KEY=""
# GEMINI_API_KEYS="key_1,key_2"

QWEN_API_KEY=""
# QWEN_API_KEYS="qwen_key_1,qwen_key_2"
# QWEN_API_ENDPOINT="https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions"

OPENAI_API_KEY=""
# OPENAI_API_KEYS="sk-key1,sk-key2"
OPENAI_TTS_MODEL="tts-1"
OPENAI_TTS_VOICE="nova"

# PostgreSQL Database Connection URL (Mandatory in production mode; dev mode falls back to local persistent store)
DATABASE_URL="postgresql://postgres:password@localhost:5432/flaw_ai"

# Secrets for Encryption & Auth (Required: minimum 32 random characters in production)
JWT_SECRET="your-32-plus-character-jwt-secret-key-goes-here"
ENCRYPTION_SECRET="your-32-plus-character-master-encryption-key-here"

# Optional LiveKit Real-time Voice Configuration
LIVEKIT_URL="wss://your-livekit-domain.livekit.cloud"
LIVEKIT_API_KEY="YOUR_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="YOUR_LIVEKIT_API_SECRET"

# Model Context Protocol (MCP) Configuration
# Default system-level MCP Server (Optional - User-specific servers are managed via Settings UI & PostgreSQL)
MCP_SERVER_URL="http://127.0.0.1:8000/sse"
# MCP_SERVER_TOKEN="Bearer your-mcp-access-token"
# Note: User-configured MCP servers, stdio commands, and headers are encrypted using ENCRYPTION_SECRET (AES-256-GCM) in PostgreSQL.

# Server Port
PORT=3000
